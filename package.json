{
  "name": "readbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "node scripts/wrangler.mjs dev",
    "deploy": "npm run build && node scripts/wrangler.mjs deploy --env production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "build:preview": "tsc -b && vite build --mode preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.59.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
